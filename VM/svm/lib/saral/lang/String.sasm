; saral/lang/String - immutable character string.
; Fields "value" ([C) and "count" (I) are required by the VM (string.c).
.class public final saral/lang/String
.super saral/lang/Object
.source String.sasm

.field private value [C
.field private count I

.method public <init> ([C)V
  .stack 3
  .locals 2
  load 0
  invokespecial saral/lang/Object <init> ()V
  load 0
  load 1
  putfield saral/lang/String value [C
  load 0
  load 1
  arraylength
  putfield saral/lang/String count I
  return
.end method

.method public length ()I
  .stack 1
  .locals 1
  load 0
  getfield saral/lang/String count I
  ireturn
.end method

.method public charAt (I)C
  .stack 2
  .locals 2
  load 0
  getfield saral/lang/String value [C
  load 1
  caload
  ireturn
.end method
.end class
