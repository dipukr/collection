; Threading: spawn two Worker threads, then wait a little.
; Run: ./svm -cp lib:examples Threads
.class public Threads
.super saral/lang/Object
.source Threads.sasm

.method public static main ([Lsaral/lang/String;)V
  .stack 3
  .locals 1
  new saral/example/Worker
  dup
  iconst 1
  invokespecial saral/example/Worker <init> (I)V
  invokevirtual saral/lang/Thread start ()V

  new saral/example/Worker
  dup
  iconst 2
  invokespecial saral/example/Worker <init> (I)V
  invokevirtual saral/lang/Thread start ()V

  ldc long 200
  invokestatic saral/lang/Thread sleep (J)V
  return
.end method
.end class
