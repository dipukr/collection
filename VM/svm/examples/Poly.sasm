; Polymorphism: a Shape[] holding a Circle and a Square, dispatched through
; the interface method area().  Run: ./svm -cp lib:examples Poly
.class public Poly
.super saral/lang/Object
.source Poly.sasm

.method public static main ([Lsaral/lang/String;)V
  .stack 5
  .locals 3
  iconst 2
  anewarray saral/example/Shape
  store 1                     ; shapes = new Shape[2]

  load 1
  iconst 0
  new saral/example/Circle
  dup
  ldc num 2.0
  invokespecial saral/example/Circle <init> (D)V
  iastore                     ; shapes[0] = new Circle(2.0)

  load 1
  iconst 1
  new saral/example/Square
  dup
  ldc num 3.0
  invokespecial saral/example/Square <init> (D)V
  iastore                     ; shapes[1] = new Square(3.0)

  iconst 0
  store 2                     ; i = 0
loop:
  load 2
  load 1
  arraylength
  if_icmpge end
  load 1
  load 2
  iaload
  invokeinterface saral/example/Shape area ()D
  invokestatic saral/lang/SVM printNum (D)V
  iconst 10
  invokestatic saral/lang/SVM printChar (C)V
  iinc 2 1
  goto loop
end:
  return
.end method
.end class
