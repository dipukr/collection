; Arithmetic + numeric types.  Computes (3+4)*2 and 10.0/4.0.
.class public Arith
.super saral/lang/Object
.source Arith.sasm

.method public static main ([Lsaral/lang/String;)V
  .stack 4
  .locals 1
  ; integer: (3 + 4) * 2 = 14
  iconst 3
  iconst 4
  iadd
  iconst 2
  imul
  invokestatic saral/lang/SVM printInt (J)V
  iconst 10
  invokestatic saral/lang/SVM printChar (C)V

  ; floating (num): 10.0 / 4.0 = 2.5
  ldc num 10.0
  ldc num 4.0
  ddiv
  invokestatic saral/lang/SVM printNum (D)V
  iconst 10
  invokestatic saral/lang/SVM printChar (C)V
  return
.end method
.end class
