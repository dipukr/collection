; Hello world.  Run:  ./svm -cp lib:examples Hello
.class public Hello
.super saral/lang/Object
.source Hello.sasm

.method public static main ([Lsaral/lang/String;)V
  .stack 2
  .locals 1
  ldc str "Hello, Saral!\n"
  invokestatic saral/lang/SVM printString (Lsaral/lang/String;)V
  return
.end method
.end class
