.class public saral/example/Worker
.super saral/lang/Thread
.source Worker.sasm

.field private id I

.method public <init> (I)V
  .stack 2
  .locals 2
  load 0
  invokespecial saral/lang/Thread <init> ()V
  load 0
  load 1
  putfield saral/example/Worker id I
  return
.end method

.method public run ()V
  .stack 2
  .locals 1
  ldc str "worker "
  invokestatic saral/lang/SVM printString (Lsaral/lang/String;)V
  load 0
  getfield saral/example/Worker id I
  invokestatic saral/lang/SVM printInt (J)V
  iconst 10
  invokestatic saral/lang/SVM printChar (C)V
  return
.end method
.end class
