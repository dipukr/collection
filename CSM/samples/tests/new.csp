package new_test;

class cls {
    var a;
    static var crlf = "\n";
	function cls(aa) {
	  a = aa;
	}
	function print() {
	  std::print(a,crlf);
	}
}


function main() {
  var s = new std::string("hello");
  print(s,"\n");	
  var a = new std::array("hello","wonderful","world");
  var i;
  for(i = 0; i < a.length; ++i) 
  {
  	print(a[i]," ");	
  }
  print("\n");	
  var c = new cls("the_cls");
  c.print();
  print(-128);
}
