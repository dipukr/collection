
package fictionbook;

import ml;


function escape(s) { return s.replace('&',"&amp;",'<',"&lt;",'>',"&gt;",'\"',"&quot;"); }

//| 
//| преобразование текстов из библиотеки Мошкова lib.ru 
//| в формат FictionBook XML 
//| 

class lib_ru_to_xml: ml::parser
{
  var ignore_content;
  var section_level;
  var state;
  var buffer;
  var genre;
  
  const ST_GROUND = 0;
  const ST_TITLE = 1;
  const ST_HEADER = 2;
  const ST_TEXT = 3;
  
  var ostream; // out stream
    
  function lib_ru_to_xml() { ignore_content = 0; state = ST_GROUND; buffer = new string(); section_level = -1; }
  
  function emit_paragraph(); 
  function emit_description(author_and_title);
  function emit_header(text);

  function emit(src_file_name, book_genre) 
  {
    genre = book_genre;
   
    var nin = new node(src_file_name);
    if( !nin.is_file ) std::out.printf("ERROR:'%s' is not a file.",src_file_name);
        
    var istream = nin.stream("R");
    if(!istream) out.printf("ERROR: cannot open '%s'\n",nin.path);
    
    var nout = new node(nin.path);
    nout.extension = "xml";
    ostream = nout.stream("W");
    if(!ostream) out.printf("ERROR: cannot create '%s'\n",nout.path);    
  
    out.printf("parsing '%s' ",nin.name_extension);
 
    ostream.put("<?xml version=\"1.0\" encoding=\"windows-1251\" ?>\n");  
    ostream.put("<FictionBook>\n");  
    
    parse(istream);  
                
    while(section_level--) ostream.put("</section>\n");
    ostream.put("</body>\n");
    ostream.put("</FictionBook>\n");  
    
    out.printf("done.\n");
  }

  function handle_text(text) 
  {
    if(text.like("     *")) // five whitespaces, paragraph begining
    {
      emit_paragraph(buffer); // emit previous
      buffer = text;
    }
    else 
    {
      buffer += (" " + text);
    }
  }

  function on_tag_open(tag_name,tag_attributes_map)
  { 
    //out.printf("tag open %s\n",tag_name); 
    switch(tag_name) 
    {
      case "TITLE": buffer.clear(); state = ST_TITLE; break;
      case "DIV":
      case "FORM":  ++ignore_content; break;
      case "H2":    state = ST_HEADER; break;
    }
    emit_paragraph(); 
    
  }
  function on_tag_close(tag_name)
  {  
    //out.printf("tag close %s\n",tag_name); 
    switch(tag_name) 
    {
      case "TITLE": emit_description(); state = ST_TEXT; break; 
      case "DIV":
      case "FORM":  --ignore_content; break;
      case "H2":    emit_header(); state = ST_TEXT; break;
    }
      
  }
  function on_text(text) 
  {
    if(ignore_content) return;
    if( state == ST_TEXT )
      handle_text(text);
    else if( state == ST_HEADER || state == ST_TITLE )
    {
      buffer += text;
    }
  }
   
}

function lib_ru_to_xml::emit_paragraph() 
{
  if(buffer.length == 0) return;
  var   state = 0;
  //|
  //| states: 0 - ground, 1 - whitespace, 2 - non whitespace
  //| 
  var text = escape(buffer);
  ostream.put("<p>");
  for(var i = 0; i < text.length; ++i) 
  {
    
    if(text[i] <= ' ') 
    { 
      if(state == 2) state = 1;
    }
    else 
    {
      if(state == 1) ostream.put(' '); 
      state = 2; 
      ostream.put(text[i]);
    }
  }
  
  ostream.put("</p>\n");
  buffer.clear();
  out.put('.');
}

function lib_ru_to_xml::emit_description() 
{
 // minimal description 
/*
<description>
 <title-info>
  <genre>Исторический роман</genre>
  <author>
   <first-name>Лев</first-name>
   <middle-name>Николаевич</middle-name>
   <last-name>Толстой</last-name>
  </author>
  <book-title>Война и мир</book-title>
 </title-info>
</description>
*/

  
  var first_name;
  var middle_name;
  var last_name;
  var book_title;

  first_name = middle_name = "";
  last_name = book_title = "unknown";
  
  //|
  //| author_and_title are coming in form of "Лев Николаевич Толстой. Кавказский пленник"
  //|
  var ar = buffer.split('.');
  if( ar.length == 2 ) 
  {
    book_title = ar[1];
    var nar = ar[0].split(' ');
    switch(nar.length) 
    {
      case 1: last_name = nar[0]; break;
      case 2: last_name = nar[1]; first_name = nar[0]; break;
      case 3: last_name = nar[2]; middle_name = nar[1]; first_name = nar[0]; break;
      default: last_name = ar[0]; break;
    }
  }
  ostream.put("<description>\n");
  ostream.put(" <title-info>\n");
  ostream.put("  <genre>"); ostream.put(genre); ostream.put("</genre>\n");
  ostream.put("  <author>\n");
  if(first_name) { ostream.put("    <first-name>"); ostream.put(first_name); ostream.put("</first-name>\n"); }
  if(middle_name) { ostream.put("    <middle-name>"); ostream.put(middle_name); ostream.put("</middle-name>\n"); }
  ostream.put("    <last-name>"); ostream.put(last_name); ostream.put("</last-name>\n");
  ostream.put("  </author>\n");
  ostream.put("  <book-title>"); ostream.put(book_title); ostream.put("</book-title>\n");
  ostream.put(" </title-info>\n");
  ostream.put("</description>\n");
  
  ostream.put("<body>\n");
  
  buffer.clear();
  
}

function lib_ru_to_xml::emit_header() {
  if(section_level > 0) ostream.put("</section>\n");
  else section_level = 1; // no multiple level yet
  //<section title="ТОМ 1"> 
  ostream.put("<section title=\""); ostream.put(escape(buffer)); ostream.put("\">\n");
  buffer.clear(); 
}


function main(input_file_name,genre_opt) 
{
  out.printf("LIB.RU HTML to FictionBook XML converter. v.0.1 \n");
  out.printf(" runtime: C-SMILE programming language\n");
  out.printf("  author: Andrew Fedoniouk.\n");
  out.printf("   email: andrew@terra-informatica.org\n");
  out.printf("     www: http://terra-informatica.org\n");
  if(input_file_name) 
  {
    var converter = new lib_ru_to_xml();
    converter.emit(input_file_name,genre_opt || "unknown");
  }
  else 
  {
      out.printf("\nUSAGE: fictionbook.exe source_file_name [book_gender]\n");
      out.printf("(enclose parameters in \"\" if they have whitespaces)\n");
  }
  
  
}
